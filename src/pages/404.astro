---
import NotFound from "../components/NotFound.astro";
---

<NotFound locale="en" />

<script>
  // GitHub Pages always serves the root 404 document for unknown paths.
  if (
    window.location.pathname.startsWith("/fr/") &&
    window.location.pathname !== "/fr/404/"
  ) {
    window.location.replace("/fr/404/");
  }
</script>
