---
import Book from "../layouts/Book.astro";
import { getCampaign, adventureUrl, chapterUrl } from "../lib/campaign";
const campaigns = await getCampaign();
---

<Book>
  <section class="cover">
    <img
      class="cover-art"
      src="/images/the-long-road.webp"
      alt="Travelers follow a mountain trail toward a mist-shrouded citadel at dawn."
      width="1672"
      height="941"
      fetchpriority="high"
    />
    <div class="cover-shade"></div>
    <div class="cover-copy">
      <p class="eyebrow">A chronicle of shared adventures</p>
      <h1>
        Every great story
        <br />
        starts with a road.
      </h1>
      <p>
        Of unlikely heroes. Of impossible choices.
        <br />
        Of the worlds we brought to life around a table.
      </p>
      <a class="button" href="#adventures">
        Open the journal <span aria-hidden="true">↓</span>
      </a>
    </div>
    <span class="cover-note">
      The Campaign Trail &nbsp; / &nbsp; Stories from the table
    </span>
  </section>
  <section id="adventures" class="library section-wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The collected chronicles</p>
        <h2>Choose an adventure</h2>
      </div>
      <p>
        Different worlds. Different companions.
        <br />
        The same call to adventure.
      </p>
    </div>
    <div class="adventure-grid">
      {campaigns.map(({ adventure, chapters }, i) => (
        <article class="adventure-card">
          <a
            href={adventureUrl(adventure.id)}
            class:list={["card-art", { "card-art-alt": i % 2 === 1 }]}
          >
            <img
              src={adventure.data.illustration.src}
              alt={adventure.data.illustration.alt}
              width="1672"
              height="941"
              loading="lazy"
            />
            <span class="volume">Volume {String(i + 1).padStart(2, "0")}</span>
          </a>
          <div class="card-copy">
            <p class="eyebrow">
              {adventure.data.setting} <span aria-hidden="true">·</span>{" "}
              {chapters.length} chapters
            </p>
            <h3>
              <a href={adventureUrl(adventure.id)}>{adventure.data.title}</a>
            </h3>
            <p>{adventure.data.description}</p>
            <a class="text-link" href={adventureUrl(adventure.id)}>
              Explore the adventure <span aria-hidden="true">→</span>
            </a>
            {chapters[0] && (
              <a class="start-link" href={chapterUrl(chapters[0])}>
                Start with chapter one
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
    <aside class="editor-note">
      <span aria-hidden="true">✧</span>
      <p>
        <strong>A journal waiting to be filled.</strong> These are sample
        adventures and chapters, setting the stage for the real stories to come.
      </p>
    </aside>
  </section>
</Book>
