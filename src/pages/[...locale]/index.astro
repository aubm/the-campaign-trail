---
import PublicationCard from "../../components/PublicationCard.astro";
import { getPublications } from "../../lib/publications";
import { localizePath } from "../../lib/i18n";
import { withBase } from "../../lib/paths";
import Book from "../../layouts/Book.astro";
import { getCampaign, adventureUrl, chapterUrl } from "../../lib/campaign";
import { locales, messages, chapterCount, type Locale } from "../../lib/i18n";
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === "en" ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props as { locale: Locale };
const t = messages[locale];
const campaigns = await getCampaign(locale);
const publications = await getPublications(locale);
const fr = locale === "fr";
---

<Book locale={locale}>
  <section class="cover">
    <img
      class="cover-art"
      src={withBase("/images/the-long-road.webp")}
      alt={t.heroAlt}
      width="1672"
      height="941"
      fetchpriority="high"
    />
    <div class="cover-shade"></div>
    <div class="cover-copy">
      <p class="eyebrow">{t.chronicle}</p>
      <h1>
        {t.heroTitle[0]}
        <br />
        {t.heroTitle[1]}
      </h1>
      <p>
        {t.heroText[0]}
        <br />
        {t.heroText[1]}
      </p>
      <a class="button" href="#adventures">
        {t.openJournal} <span aria-hidden="true">↓</span>
      </a>
    </div>
    <span class="cover-note">
      The Campaign Trail &nbsp; / &nbsp; {t.tagline}
    </span>
  </section>
  <section class="play-feature section-wrap" aria-labelledby="play-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          {fr ? "À votre tour de lancer les dés" : "Your turn to roll the dice"}
        </p>
        <h2 id="play-title">{t.publications}</h2>
      </div>
      <a class="text-link" href={localizePath("/play/", locale)}>
        {fr ? "Découvrir les scénarios" : "Explore the adventures"} →
      </a>
    </div>
    {publications.slice(0, 1).map((publication) => (
      <PublicationCard publication={publication} />
    ))}
  </section>
  <section id="adventures" class="library section-wrap">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{t.collected}</p>
        <h2>{t.choose}</h2>
      </div>
      <p>
        {t.libraryText[0]}
        <br />
        {t.libraryText[1]}
      </p>
    </div>
    <div class="adventure-grid">
      {campaigns.map(({ adventure, chapters }, i) => (
        <article class="adventure-card">
          <a
            href={adventureUrl(adventure.id, locale)}
            class:list={["card-art", { "card-art-alt": i % 2 === 1 }]}
          >
            <img
              src={withBase(adventure.data.illustration.src)}
              alt={adventure.data.illustration.alt}
              width="1672"
              height="941"
              loading="lazy"
            />
            <span class="volume">
              {t.volume} {String(i + 1).padStart(2, "0")}
            </span>
          </a>
          <div class="card-copy">
            <p class="eyebrow">
              {adventure.data.setting} <span aria-hidden="true">·</span>{" "}
              {chapterCount(chapters.length, locale)}
            </p>
            <h3>
              <a href={adventureUrl(adventure.id, locale)}>
                {adventure.data.title}
              </a>
            </h3>
            {adventure.data.translationPending && (
              <span class="availability-note">{t.frenchOnlyShort}</span>
            )}
            <p>{adventure.data.description}</p>
            <a class="text-link" href={adventureUrl(adventure.id, locale)}>
              {t.explore} <span aria-hidden="true">→</span>
            </a>
            {chapters[0] && (
              <a class="start-link" href={chapterUrl(chapters[0])}>
                {chapters[0].data.order === 0 ? t.readPrologue : t.start}
              </a>
            )}
          </div>
        </article>
      ))}
      {campaigns.length === 1 && (
        <aside class="upcoming-adventure" aria-labelledby="upcoming-adventure-title">
          <span class="upcoming-mark" aria-hidden="true">✧</span>
          <p class="eyebrow">{t.upcomingEyebrow}</p>
          <h3 id="upcoming-adventure-title">{t.upcomingTitle}</h3>
          <p>{t.upcomingDescription}</p>
        </aside>
      )}
    </div>
  </section>
</Book>
