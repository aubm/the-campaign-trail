---
import Book from "../../../layouts/Book.astro";
import PublicationCard from "../../../components/PublicationCard.astro";
import { getPublications } from "../../../lib/publications";
import {
  locales,
  messages,
  localizePath,
  type Locale,
} from "../../../lib/i18n";
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === "en" ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props as { locale: Locale };
const fr = locale === "fr";
const publications = await getPublications(locale);
---

<Book
  locale={locale}
  title={messages[locale].publications}
  description={
    fr
      ? "Des aventures originales pour votre table de D&D, écrites par Aurélien Baumann."
      : "Original adventures for your D&D table, written by Aurélien Baumann."
  }
>
  <header class="play-intro section-wrap">
    <p class="eyebrow">
      {fr ? "De mon carnet à votre table" : "From my notebook to your table"}
    </p>
    <h1>{messages[locale].publications}</h1>
    <p class="subtitle">
      {fr
        ? "Un point de départ pour vos propres histoires."
        : "A starting point for stories of your own."}
    </p>
    <p class="play-intro-copy">
      {fr
        ? "J’aime autant préparer une aventure que voir ce que les joueurs en feront. Retrouvez ici les scénarios que j’ai écrits et publiés, pour les faire vivre à votre tour."
        : "I enjoy preparing an adventure as much as discovering what players will make of it. Here are the adventures I’ve written and published, ready for a new life at your table."}
    </p>
  </header>
  <section
    class="publication-catalog section-wrap"
    aria-label={messages[locale].publications}
  >
    {publications.map((publication) => (
      <PublicationCard publication={publication} />
    ))}
  </section>
  <aside class="journal-crosslink section-wrap">
    <p>
      {fr
        ? "Envie de suivre les histoires vécues autour de ma table ?"
        : "Want to follow the stories from my own table?"}
    </p>
    <a class="text-link" href={localizePath("/#adventures", locale)}>
      {fr ? "Lire les chroniques" : "Read the chronicles"} →
    </a>
  </aside>
</Book>
