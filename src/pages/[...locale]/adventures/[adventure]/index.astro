---
import { render } from "astro:content";
import Book from "../../../../layouts/Book.astro";
import { getCampaign, chapterUrl } from "../../../../lib/campaign";
import {
  locales,
  contentKey,
  localizePath,
  messages,
  chapterCount,
} from "../../../../lib/i18n";
export async function getStaticPaths() {
  return (
    await Promise.all(
      locales.map(async (locale) =>
        (await getCampaign(locale)).map((item) => ({
          params: {
            locale: locale === "en" ? undefined : locale,
            adventure: contentKey(item.adventure.id),
          },
          props: { ...item, locale },
        })),
      ),
    )
  ).flat();
}
const { adventure, chapters, locale } = Astro.props;
const t = messages[locale];
const { Content } = await render(adventure);
---

<Book
  locale={locale}
  title={adventure.data.title}
  description={adventure.data.description}
  image={adventure.data.illustration.src}
>
  <div class="section-wrap">
    <nav class="breadcrumbs" aria-label={t.breadcrumb}>
      <a href={localizePath("/", locale)}>{t.journal}</a>
      <span aria-hidden="true">/</span>
      <span>{adventure.data.title}</span>
    </nav>
  </div>
  <section class="adventure-intro section-wrap">
    <p class="eyebrow">
      {adventure.data.setting} · {chapterCount(chapters.length, locale)}
    </p>
    <h1>{adventure.data.title}</h1>
    <p class="subtitle">{adventure.data.subtitle}</p>
    {adventure.data.translationPending && (
      <p class="language-availability">{t.frenchOnlyShort}</p>
    )}
    <figure class="panorama">
      <img
        src={adventure.data.illustration.src}
        alt={adventure.data.illustration.alt}
        width="1672"
        height="941"
        fetchpriority="high"
      />
      {adventure.data.illustration.caption && (
        <figcaption>{adventure.data.illustration.caption}</figcaption>
      )}
    </figure>
  </section>
  <section class="contents-layout section-wrap">
    <div class="prose">
      <p class="eyebrow">{t.adventure}</p>
      <Content />
      {chapters[0] && (
        adventure.data.translationPending ? (
          <a class="button" href={localizePath(chapterUrl(chapters[0]), "fr")} hreflang="fr">
            {t.readFrenchOriginal} <span aria-hidden="true">→</span>
          </a>
        ) : (
          <a class="button" href={chapterUrl(chapters[0])}>
            {chapters[0].data.order === 0 ? t.readPrologue : t.begin}{" "}
            <span aria-hidden="true">→</span>
          </a>
        )
      )}
    </div>
    <div class="contents">
      <p class="eyebrow">{t.turnPage}</p>
      <h2>{t.contents}</h2>
      <ol>
        {chapters.map((chapter) => (
          <li>
            <a href={chapterUrl(chapter)}>
              <span class="chapter-number">
                {String(chapter.data.order).padStart(2, "0")}
              </span>
              <div>
                <h3>{chapter.data.title}</h3>
                <p>{chapter.data.summary}</p>
              </div>
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
      {!chapters.length && <p>{t.empty}</p>}
    </div>
  </section>
</Book>
