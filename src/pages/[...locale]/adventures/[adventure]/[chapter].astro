---
import { render } from "astro:content";
import Book from "../../../../layouts/Book.astro";
import { withBase, withBaseSrcset } from "../../../../lib/paths";
import {
  getCampaign,
  adventureUrl,
  chapterUrl,
} from "../../../../lib/campaign";
import {
  locales,
  contentKey,
  localizePath,
  messages,
} from "../../../../lib/i18n";
export async function getStaticPaths() {
  return (
    await Promise.all(
      locales.map(async (locale) =>
        (await getCampaign(locale)).flatMap(({ adventure, chapters }) =>
          chapters.map((chapter, index) => ({
            params: {
              locale: locale === "en" ? undefined : locale,
              adventure: contentKey(adventure.id),
              chapter: chapter.id.split("/").at(-1),
            },
            props: {
              adventure,
              chapters,
              chapter,
              previous: chapters[index - 1],
              next: chapters[index + 1],
              locale,
            },
          })),
        ),
      ),
    )
  ).flat();
}
const { adventure, chapter, chapters, previous, next, locale } = Astro.props;
const t = messages[locale];
const { Content, headings } = await render(chapter);
---

<Book
  locale={locale}
  title={chapter.data.title}
  description={chapter.data.summary}
  image={chapter.data.illustration.src}
>
  <div class="section-wrap">
    <nav class="breadcrumbs" aria-label={t.breadcrumb}>
      <a href={localizePath("/", locale)}>{t.journal}</a>
      <span aria-hidden="true">/</span>
      <a href={adventureUrl(adventure.id, locale)}>{adventure.data.title}</a>
      <span aria-hidden="true">/</span>
      <span>
        {chapter.data.order === 0 ? t.prologue : `${t.chapter} ${chapter.data.order}`}
      </span>
    </nav>
  </div>
  <article>
    <header class="chapter-header section-wrap">
      <p class="eyebrow">
        {adventure.data.title} <span aria-hidden="true">✧</span>{" "}
        {chapter.data.order === 0 ? `${t.prologue} · ${t.chapter} 0` : `${t.chapter} ${String(chapter.data.order).padStart(2, "0")}`}
      </p>
      <h1>{chapter.data.title}</h1>
      <p class="subtitle">{chapter.data.summary}</p>
    </header>
    <figure class="chapter-illustration section-wrap">
      <img
        src={withBase(chapter.data.illustration.src)}
        srcset={withBaseSrcset(chapter.data.illustration.srcset)}
        sizes="(max-width: 850px) calc(100vw - 48px), (max-width: 1256px) calc(100vw - 96px), 1160px"
        alt={chapter.data.illustration.alt}
        width="1672"
        height="941"
        fetchpriority="high"
      />
      {chapter.data.illustration.caption && (
        <figcaption>{chapter.data.illustration.caption}</figcaption>
      )}
    </figure>
    <div class="reading-layout section-wrap">
      <aside class="reading-sidebar">
        <details open>
          <summary>{t.inAdventure}</summary>
          <ol>
            {chapters.map((item) => (
              <li>
                <a
                  href={chapterUrl(item)}
                  aria-current={item.id === chapter.id ? "page" : undefined}
                >
                  <span>{String(item.data.order).padStart(2, "0")}</span>
                  {item.data.title}
                </a>
              </li>
            ))}
          </ol>
        </details>
        {headings.filter((h) => h.depth === 2).length > 0 && (
          <nav aria-label={t.onPage}>
            <p class="eyebrow">{t.onPage}</p>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <a href={`#${h.slug}`}>{h.text}</a>
              ))}
          </nav>
        )}
        <a class="text-link" href={adventureUrl(adventure.id, locale)}>
          ← {t.adventureContents}
        </a>
      </aside>
      <div>
        {chapter.data.translationPending && (
          <aside class="translation-notice" aria-label={t.frenchEdition}>
            <p class="eyebrow">{t.frenchEdition}</p>
            <p>{t.translationNotice}</p>
            <a
              class="button"
              href={localizePath(Astro.url.pathname, "fr")}
              hreflang="fr"
            >
              {t.readFrenchOriginal} <span aria-hidden="true">→</span>
            </a>
          </aside>
        )}
        {!chapter.data.translationPending && (
          <div class:list={["prose", "chapter-prose", { "story-prose": !chapter.data.sample }]}>
            {chapter.data.sample && <p class="sample-label">{t.sample}</p>}
            <Content />
          </div>
        )}
        <nav class="chapter-pagination" aria-label={t.chapterNavigation}>
          {previous ? (
            <a rel="prev" href={chapterUrl(previous)}>
              <span class="eyebrow">← {t.previous}</span>
              <strong>{previous.data.title}</strong>
            </a>
          ) : (
            <a href={adventureUrl(adventure.id, locale)}>
              <span class="eyebrow">← {t.back}</span>
              <strong>{t.adventureContents}</strong>
            </a>
          )}
          {next ? (
            <a rel="next" href={chapterUrl(next)}>
              <span class="eyebrow">{t.next} →</span>
              <strong>{next.data.title}</strong>
            </a>
          ) : (
            <a href={localizePath("/#adventures", locale)}>
              <span class="eyebrow">{t.pause}</span>
              <strong>{t.another} →</strong>
            </a>
          )}
        </nav>
      </div>
    </div>
  </article>
</Book>
