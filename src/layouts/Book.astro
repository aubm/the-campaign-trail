---
import "@fontsource/cormorant-garamond/500.css";
import "@fontsource/cormorant-garamond/600.css";
import "@fontsource/source-serif-4/400.css";
import "@fontsource/source-serif-4/400-italic.css";
import "../styles/book.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import { isPreview, withBase } from "../lib/paths";
import { localizePath, messages, type Locale } from "../lib/i18n";
interface Props {
  locale?: Locale;
  alternatePaths?: Record<Locale, string>;
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  locale = "en",
  alternatePaths,
  description,
  image = "/images/the-long-road.webp",
} = Astro.props;
const t = messages[locale];
const pageDescription = description ?? t.description;
const paths = alternatePaths ? {
  en: withBase(alternatePaths.en),
  fr: withBase(alternatePaths.fr),
} : {
  en: localizePath(Astro.url.pathname, "en"),
  fr: localizePath(Astro.url.pathname, "fr"),
};
const pageTitle = title
  ? `${title} · The Campaign Trail`
  : `The Campaign Trail · ${t.tagline}`;
const canonical = new URL(paths[locale], Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <GoogleAnalytics />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL(paths.en, Astro.site)} />
    <link rel="alternate" hreflang="fr" href={new URL(paths.fr, Astro.site)} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(paths.en, Astro.site)}
    />
    <meta property="og:locale" content={locale === "fr" ? "fr_CA" : "en_CA"} />
    <meta
      property="og:locale:alternate"
      content={locale === "fr" ? "en_CA" : "fr_CA"}
    />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(withBase(image), Astro.site)} />
    <meta name="theme-color" content="#702e2d" />
  </head>
  <body>
    <a href="#main" class="skip-link">
      {t.skip}
    </a>
    <header class="site-header">
      <a class="wordmark" href={localizePath("/", locale)}>
        <span class="seal" aria-hidden="true">
          ✧
        </span>{" "}
        The Campaign Trail
      </a>
      <div class="header-links">
        <a class="library-link" href={localizePath("/#adventures", locale)}>
          {t.adventures} <span aria-hidden="true">↗</span>
        </a>
        <a class="library-link" href={localizePath("/play/", locale)}>
          {t.publications}
        </a>
        <nav class="language-switch" aria-label={t.language}>
          <a
            href={paths.en}
            lang="en"
            hreflang="en"
            aria-label="English"
            aria-current={locale === "en" ? "true" : undefined}
          >
            EN
          </a>
          <span aria-hidden="true">/</span>
          <a
            href={paths.fr}
            lang="fr"
            hreflang="fr"
            aria-label="Français"
            aria-current={locale === "fr" ? "true" : undefined}
          >
            FR
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <a href={localizePath("/", locale)}>The Campaign Trail</a>
      <p>{t.footer}</p>
      <span>
        {t.independent}
        <br />
        <a
          href="https://www.aubm.net/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label={
            locale === "fr"
              ? "Site personnel d’Aurélien Baumann"
              : "Aurélien Baumann’s personal website"
          }
        >
          aubm.net <span aria-hidden="true">↗</span>
        </a>
      </span>
    </footer>
    <script>
      function openExternalLinksInNewTabs() {
        for (const link of document.querySelectorAll<HTMLAnchorElement>(
          "a[href]",
        )) {
          const url = new URL(link.href, window.location.href);
          if (
            (url.protocol === "https:" || url.protocol === "http:") &&
            url.origin !== window.location.origin
          ) {
            link.target = "_blank";
            link.relList.add("noopener", "noreferrer");
          }
        }
      }
      openExternalLinksInNewTabs();
      document.addEventListener("astro:page-load", openExternalLinksInNewTabs);
    </script>
  </body>
</html>
